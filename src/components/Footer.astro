---
const anio = new Date().getFullYear();
---

<footer class="bg-blue-950 py-5 text-white">
  <div class="mx-auto max-w-7xl px-6">

    <div class="flex flex-col items-center justify-between gap-8 md:flex-row">

      <!-- Empresa -->
      <div class="text-center md:text-left">
        <h3 class="text-xl font-bold">
          RCode Systems
        </h3>
        <p class="mt-2 text-sm text-blue-100">
          Transformamos ideas en soluciones.
        </p>
      </div>
<!-- Redes sociales -->
<div class="flex items-center gap-6">

  <!-- Facebook -->
  <a
   href="https://www.facebook.com/share/1CXUfKf33Y/"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Facebook"
    class="transition hover:scale-110 hover:text-blue-400"
  >
    <svg class="h-6 w-6" viewBox="0 0 24 24"
      fill="currentColor" aria-hidden="true">
      <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.19 2.23.19v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99A10 10 0 0 0 22 12z"/>
    </svg>
  </a>

  <!-- WhatsApp -->
  <a
    href="https://wa.me/50374286197"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="WhatsApp"
    class="transition hover:scale-110 hover:text-green-400"
  >
    <svg class="h-6 w-6" viewBox="0 0 24 24"
      fill="currentColor" aria-hidden="true">
      <path d="M20.52 3.48A11.87 11.87 0 0 0 12.05 0C5.46 0 .1 5.36.1 11.95c0 2.11.55 4.17 1.59 5.99L0 24l6.22-1.63a11.9 11.9 0 0 0 5.83 1.49h.01c6.59 0 11.95-5.36 11.95-11.95a11.87 11.87 0 0 0-3.49-8.43zM12.06 21.84a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-3.69.97.98-3.6-.23-.37a9.9 9.9 0 0 1-1.52-5.3c0-5.47 4.45-9.92 9.92-9.92a9.86 9.86 0 0 1 7.01 2.91 9.85 9.85 0 0 1 2.9 7.01c0 5.47-4.45 9.89-9.96 9.89zm5.44-7.42c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37s-1.04 1.02-1.04 2.49 1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.09 4.49.71.31 1.26.49 1.69.63.71.23 1.35.2 1.86.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35z"/>
