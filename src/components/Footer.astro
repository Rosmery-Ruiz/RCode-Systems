  </a>

  <!-- Correo -->
  <a
    href="mailto:rcodesystems@gmail.com"
    aria-label="Enviar correo"
    class="transition hover:scale-110 hover:text-sky-300"
  >
    <svg class="h-6 w-6" viewBox="0 0 24 24"
      fill="none" stroke="currentColor" stroke-width="2"
      stroke-linecap="round" stroke-linejoin="round"
      aria-hidden="true">
      <rect x="2" y="4" width="20" height="16" rx="2"/>
      <path d="m22 7-10 6L2 7"/>
    </svg>
  </a>

</div>

    </div>

    <div class="mt-4 border-t border-blue-800 pt-3 text-center">
      <p class="text-sm text-blue-200">
        © {anio} RCode Systems. Todos los derechos reservados.
      </p>
    </div>

  </div>
</footer>