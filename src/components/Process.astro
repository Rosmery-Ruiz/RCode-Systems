
---
const pasos = [
  {
    numero: "01",
    titulo: "Cuéntanos tu idea",
    descripcion:
      "Escuchamos tus necesidades y conocemos los objetivos de tu proyecto."
  },
  {
    numero: "02",
    titulo: "Analizamos tu proyecto",
    descripcion:
      "Evaluamos los requerimientos y presentamos una propuesta con alcance, costos y tiempos estimados."
  },
  {
    numero: "03",
    titulo: "Diseñamos y desarrollamos",
    descripcion:
      "Una vez aprobada la propuesta, diseñamos y desarrollamos una solución adaptada a tus necesidades."
  },
  {
    numero: "04",
    titulo: "Entregamos tu solución",
    descripcion:
      "Realizamos la entrega del proyecto con la documentación y las indicaciones necesarias para su uso."
  }
];
---

<section id="proceso" class="bg-white pt-8 pb-6 sm:pt-8 sm:pb-6">
  <div class="mx-auto max-w-7xl px-6">

    <!-- Encabezado -->
    <div class="mb-9 text-center sm:mb-10">

      <span
        class="text-xs font-semibold uppercase tracking-widest text-blue-600 sm:text-sm"
      >
        NUESTRO PROCESO
      </span>

      <h2
        class="mt-4 text-3xl font-bold text-blue-950 sm:text-4xl"
      >
        ¿Cómo trabajamos?
      </h2>

      <p
        class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-slate-600 sm:text-base"
      >
        Transformamos tus ideas en soluciones mediante
        un proceso organizado, claro y profesional.
      </p>

    </div>

    <!-- Tarjetas del proceso -->
    <div class="grid gap-5 sm:gap-6 md:grid-cols-2 lg:grid-cols-4">

      {pasos.map((paso) => (

        <article
          class="rounded-2xl border border-blue-100 bg-white
                 p-6 shadow-sm transition-all duration-300
                 hover:-translate-y-2 hover:shadow-lg sm:p-8"
        >

          <!-- Número -->
          <span class="text-3xl font-bold text-blue-600 sm:text-4xl">
            {paso.numero}
          </span>

          <!-- Título -->
          <h3 class="mt-4 text-lg font-bold text-blue-950 sm:mt-5 sm:text-xl">
            {paso.titulo}
          </h3>

          <!-- Descripción -->
          <p class="mt-3 text-sm leading-7 text-slate-600 sm:mt-4 sm:text-base">
            {paso.descripcion}
          </p>

        </article>

      ))}

    </div>

  </div>
</section>
